# ─── MeshCarrier Backend Environment Variables ────────────────────────────────
# Copy this file to .env and fill in your values
# Run: cp .env.example .env

# JWT signing secret (change this in production!)
JWT_SECRET=meshcarrier-secret-change-me-in-production

# Server port
PORT=3001

# ─── Gigs.com eSIM Integration ───────────────────────────────────────────────
# Sign up at https://gigs.com and get your credentials from:
# Dashboard → Developers → API Keys

# Your Gigs API Bearer token
GIGS_API_KEY=your_gigs_api_key_here

# Your Gigs Project ID (format: prj_xxxx or similar)
GIGS_PROJECT=your_gigs_project_id_here

# Webhook signing secret (Dashboard → Developers → Webhooks)
GIGS_WEBHOOK_SECRET=your_webhook_secret_here

# Map MeshCarrier plans to Gigs plan IDs
# Run: GET http://localhost:3001/api/esim/plans  (after setting GIGS_API_KEY + GIGS_PROJECT)
# to see your available Gigs plan IDs, then paste them below:
GIGS_PLAN_NODE=pln_your_node_plan_id
GIGS_PLAN_MESH=pln_your_mesh_plan_id
GIGS_PLAN_CARRIER=pln_your_carrier_plan_id

# ─── Future integrations ─────────────────────────────────────────────────────
# Twilio (Voice + SMS)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=

# XRPL
# XRPL_WALLET_SEED=
# XRPL_NETWORK=mainnet

# ─── Live Mode ───────────────────────────────────────────────────────────────
# Set to true to disable auto-seeding with demo data
LIVE_MODE=false

# Production accounts (used by reseed-live.js)
SUPERADMIN_EMAIL=admin@meshcarrier.xyz
SUPERADMIN_PASSWORD=
SUPERADMIN_NAME=MeshCarrier Admin

USER_EMAIL=
USER_PASSWORD=
USER_NAME=
USER_PLAN=NODE
